# ==============================================================================
# Lungent Backend Service — Environment Variables Template
# ==============================================================================
# Duplicate this file to `.env` or set these in Render Environment Variables.
# NEVER commit real production credentials to Git.
# ==============================================================================

# API & Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*

# LLM Providers (Groq / Ollama Fallback)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Admin / Clinician Seed Credentials (Optional for local test seed)
ADMIN_SEED_EMAIL=your_email@example.com
ADMIN_SEED_PASSWORD=your_secure_password_here
ADMIN_SEED_NAME=Clinician Evaluator

# Email / Contact Form SMTP Configuration (If using SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here

