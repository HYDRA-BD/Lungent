# ==============================================================================
# Lungent Platform — Environment Variables Template
# ==============================================================================
# Duplicate this file to `.env.local` for local development.
# DO NOT commit real secrets or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration (Browser & Server)
# ------------------------------------------------------------------------------
# The public Supabase project URL (e.g., https://your-project.supabase.co or http://127.0.0.1:54321 for local CLI)
NEXT_PUBLIC_SUPABASE_URL=

# The public anonymous API key (safe for browser exposure with Row Level Security enabled)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# Supabase Administrative Configuration (Server Only)
# ------------------------------------------------------------------------------
# CRITICAL: Service role key bypasses Row Level Security (RLS).
# MUST ONLY be accessible in trusted server-side execution contexts.
# NEVER prefix with NEXT_PUBLIC_ or expose to browser client code.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------------------
# Application base URL (used for canonical links, email callbacks, and SSR redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node Environment ('development' | 'test' | 'production')
NODE_ENV=development

# ------------------------------------------------------------------------------
# Backend API Configuration (FastAPI / Hugging Face Spaces / Local)
# ------------------------------------------------------------------------------
# Local development default:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
#
# Hugging Face Spaces deployment (CPU Basic tier with Docker):
# NEXT_PUBLIC_API_URL=https://<your-hf-username>-<space-name>.hf.space
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# Contact & Email Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=support@lungent.org
EMAIL_PASSWORD=your_app_password_here
